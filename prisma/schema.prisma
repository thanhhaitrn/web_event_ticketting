generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id         String      @id @default(cuid())
  name       String
  // served by /api/uploads/[name]; null falls back to the gradient tile
  imageUrl   String?
  // venue map shown on the ticket page, same upload rules as the poster
  seatMapUrl String?
  // key of a hand-drawn plan in lib/venue-plans.ts; null draws rings from the ticket tiers
  venuePlan  String?
  artists    Artist[]
  genres     Genre[]
  // venue name only, e.g. "SVĐ Mỹ Đình"; the province carries the city
  location   String
  provinceCode Int?
  province   Province?   @relation(fields: [provinceCode], references: [code])
  startTime  DateTime
  endTime    DateTime
  saleStart  DateTime
  saleEnd    DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  zones      Zone[]
  phases     SalePhase[]
  shows      Show[]
}

model Zone {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  // hex colour matching the venue map, so buyers can find the zone on it
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  prices    ZonePrice[]
  // how many tickets of this zone each night sells
  quotas    ZoneQuota[]
  reservations SeatReservation[]
}

// one night of a multi-night event; the event's start/end span its shows
model Show {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  quotas    ZoneQuota[]
  orders    Order[]
  reservations SeatReservation[]
}

// tickets of one zone on sale for one night; a missing row means none
model ZoneQuota {
  id        String   @id @default(cuid())
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, showId])
}

model SalePhase {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  prices    ZonePrice[]
}

model ZonePrice {
  id           String    @id @default(cuid())
  zoneId       String
  zone         Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        SalePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  floorPrice   Int
  basePrice    Int
  ceilingPrice Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([zoneId, phaseId])
}

model Province {
  code     Int     @id
  name     String  @unique
  fullName String
  events   Event[]
}

model Genre {
  slug      String  @id
  name      String  @unique
  // MusicBrainz genre id, so the list can be re-synced against the source
  mbid      String  @unique
  featured  Boolean @default(false)
  sortOrder Int
  events    Event[]
}

// one purchase attempt: seats are held while HELD and sold once PAID
model Order {
  id          String   @id @default(cuid())
  // anonymous browser id from the venu_buyer cookie, until accounts exist
  buyerId     String
  showId      String
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  status      String   // HELD | PAID | EXPIRED | CANCELLED
  // "buyer:show" while HELD, null afterwards: the database allows one live hold per buyer per night
  activeKey   String?  @unique
  seatCount   Int
  totalAmount Int
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  seats       SeatReservation[]

  @@index([status, expiresAt])
}

// Seats are numbered 1..capacity and have no row of their own; a row exists only
// while a seat is held or sold. The unique index is what makes overselling impossible.
model SeatReservation {
  id         String    @id @default(cuid())
  showId     String
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  zoneId     String
  zone       Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  seatNumber Int
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     String    // HELD | SOLD
  price      Int
  // set while HELD; once past, the seat counts as free
  expiresAt  DateTime?

  @@unique([showId, zoneId, seatNumber])
  @@index([status, expiresAt])
  @@index([orderId])
}

model Artist {
  id        String   @id @default(cuid())
  // for the page address (/artists/bigbang); also what makes "soobin" and "SOOBIN" one artist
  slug      String   @unique
  name      String   @unique
  // own photo; null falls back to the poster of one of their events
  imageUrl  String?
  createdAt DateTime @default(now())
  events    Event[]
}
