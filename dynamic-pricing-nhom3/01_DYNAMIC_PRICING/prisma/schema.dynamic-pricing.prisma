// 1) Thêm vào model ZonePrice hiện có:
//
// model ZonePrice {
//   ...các field Sprint 1 (zoneId, phaseId, floorPrice, basePrice, ceilingPrice)...
//   dynamicEnabled Boolean @default(false)
//   @@unique([zoneId, phaseId])
// }

// 2) Model mới:
model PriceChange {
  id        String   @id @default(cuid())
  zoneId    String
  showId    String
  phaseId   String
  /// floor(epochMs / 15 phút) — chống ghi trùng khi recompute bị gọi hai lần cùng lúc
  cycle     Int
  oldPrice  Int
  newPrice  Int
  /// O = S / C tại thời điểm đổi
  occupancy Float
  /// E — tỷ lệ bán kỳ vọng
  expected  Float
  /// Quy tắc đã áp dụng, ví dụ "a_cau=+15.0%;a_gio_chot=0.0%;a_giu=0.0%;u=+0.75;limit=step10"
  rule      String
  createdAt DateTime @default(now())

  zone  Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  show  Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  phase SalePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([zoneId, showId, phaseId, cycle])
  @@index([zoneId, showId, phaseId, createdAt])
}

